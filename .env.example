# ── Network ──────────────────────────────────────────────
# testnet | mainnet
NEXT_PUBLIC_STELLAR_NETWORK=testnet
# Optional overrides (defaults derived from the network above)
NEXT_PUBLIC_STELLAR_RPC_URL=
NEXT_PUBLIC_STELLAR_EXPLORER_URL=

# ── Soroban contracts ────────────────────────────────────
# Smart-account (passkey wallet) contract. Used as the wasm/factory reference;
# each user's deployed account address is returned by the backend at signup.
NEXT_PUBLIC_ACCOUNT_CONTRACT_ID=C...
# Fee-subsidy / paymaster contract
NEXT_PUBLIC_SUBSIDY_CONTRACT_ID=C...

# ── Stablecoin SAC addresses (Stellar Asset Contracts) ──
NEXT_PUBLIC_USDC_CONTRACT_ID=C...
NEXT_PUBLIC_EURC_CONTRACT_ID=C...
NEXT_PUBLIC_ARST_CONTRACT_ID=C...
NEXT_PUBLIC_BRLA_CONTRACT_ID=C...

# ── WebAuthn ─────────────────────────────────────────────
# Must equal the registrable domain of the HTTPS origin serving the app.
NEXT_PUBLIC_WEBAUTHN_RP_ID=localhost
NEXT_PUBLIC_WEBAUTHN_RP_NAME=RemitPulse
# Comma-separated list of origins the backend should accept in clientDataJSON.
NEXT_PUBLIC_APP_ORIGIN=https://localhost:3000

# ── Relay / backend ──────────────────────────────────────
# Paymaster fee-bump sponsorship, session-key issuance, quotes, SEP-24 proxy.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
# Origins allowed to be framed / to postMessage during SEP-24 (anchor portals).
NEXT_PUBLIC_SEP24_ALLOWED_ORIGINS=https://testanchor.stellar.org

# ── Session keys ─────────────────────────────────────────
# Transfers at or below this amount (in send-asset units) sign with the Ed25519
# session key instead of prompting for the passkey.
NEXT_PUBLIC_SESSION_KEY_MAX_AMOUNT=50
NEXT_PUBLIC_SESSION_KEY_TTL_MINUTES=30

# ── Local development ────────────────────────────────────
# true = mock backend responses (passkey prompts are still real WebAuthn).
NEXT_PUBLIC_DEMO_MODE=true
