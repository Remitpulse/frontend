{
  "name": "remitpulse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RemitPulse — passkey-secured cross-border remittances on Stellar/Soroban.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@stellar/stellar-sdk": "^17.3.0",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@testing-library/react": "^16.3.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.10.3",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^27.0.0",
    "lint-staged": "^16.1.6",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
